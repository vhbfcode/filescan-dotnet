    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileScan.Core\FileScan.Core.csproj" />
  </ItemGroup>

</Project>
