<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FileScan.Core — biblioteca reutilizável de validação de arquivos.
    Sem ClamAV, sem ASP.NET: validação estrutural (Mime-Detective) + detecção de conteúdo
    ativo multi-formato, consumível por qualquer app .NET via `new FileScanService(options)`.
    Uma integração antivírus é opcional e plugável via IVirusScanner.
  -->

  <PropertyGroup>
    <Description>Fail-closed upload validation for .NET, in-process: real content-type checking, bounded structural PDF parsing, recursive embedded-file inspection, and active-content detection for PDF/Office/CSV/images. Optional pluggable antivirus via IVirusScanner. Defense-in-depth, not a malware certificate or certified CDR.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Metadado do pacote NuGet -->
  <PropertyGroup>
    <PackageId>FileScan.Core</PackageId>
    <Authors>Vitor Fallavena</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/vhbfcode/filescan-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vhbfcode/filescan-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>file-validation;upload-security;pdf;javascript-detection;macro-detection;csv-injection;owasp;mime;magic-bytes;antivirus;security</PackageTags>
    <PackageReleaseNotes>See https://github.com/vhbfcode/filescan-dotnet/releases</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mime-Detective" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

</Project>
