<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FileScan.Core — biblioteca reutilizável de validação de arquivos.
    Sem ClamAV, sem ASP.NET: validação estrutural (Mime-Detective) + detecção de conteúdo
    ativo multi-formato, consumível por qualquer app .NET via `new FileScanService(options)`.
    Uma integração antivírus é opcional e plugável via IVirusScanner.
  -->

  <PropertyGroup>
    <Description>Fail-closed upload validation for .NET: real content-type checking, bounded structural PDF parsing, recursive embedded-file inspection, and active-content detection for PDF/Office/CSV/images. PDF parsing runs in an isolated worker process by default (a PdfPig stack overflow cannot take down the host). Optional pluggable antivirus via IVirusScanner. Defense-in-depth, not a malware certificate or certified CDR.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Metadado do pacote NuGet -->
  <PropertyGroup>
    <PackageId>FileScan.Core</PackageId>
    <Authors>Vitor Fallavena</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/vhbfcode/filescan-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vhbfcode/filescan-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>file-validation;upload-security;pdf;javascript-detection;macro-detection;csv-injection;owasp;mime;magic-bytes;antivirus;security</PackageTags>
    <PackageReleaseNotes>See https://github.com/vhbfcode/filescan-dotnet/releases</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mime-Detective" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <!--
    O FileScan.Worker (processo filho) vai DENTRO do nupkg e acompanha o output/publish de quem referencia o Core
    (por pacote OU por ProjectReference). O worker compila os fontes do Core, então a referência é só de build
    (ordem + restore): ReferenceOutputAssembly=false e PrivateAssets=all => não vira dependência do nuspec.
  -->
  <ItemGroup>
    <ProjectReference Include="..\FileScan.Worker\FileScan.Worker.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="build\FileScan.Core.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Target Name="IncludeWorkerFiles" DependsOnTargets="ResolveProjectReferences"
          BeforeTargets="AssignTargetPaths;_GetPackageFiles">
    <MSBuild Projects="..\FileScan.Worker\FileScan.Worker.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_WorkerDll" />
    </MSBuild>
    <PropertyGroup>
      <_WorkerDir>$([System.IO.Path]::GetDirectoryName('$(_WorkerDll)'))$([System.IO.Path]::DirectorySeparatorChar)</_WorkerDir>
    </PropertyGroup>
    <ItemGroup>
      <_WorkerFile Include="$(_WorkerDir)**" Exclude="$(_WorkerDir)**\*.pdb;$(_WorkerDir)**\*.xml" />
      <None Include="@(_WorkerFile)"
            Link="filescan-worker\%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            Pack="true"
            PackagePath="tools\filescan-worker\%(RecursiveDir)" />
    </ItemGroup>
  </Target>

</Project>
