<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <FileScanPackageVersion Condition="'$(FileScanPackageVersion)' == ''">0.2.0</FileScanPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberadamente PackageReference: este smoke test não pode enxergar o projeto Core. -->
    <PackageReference Include="FileScan.Core" Version="$(FileScanPackageVersion)" />
  </ItemGroup>
</Project>
