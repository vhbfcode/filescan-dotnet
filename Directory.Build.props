<Project>

  <!--
    Directory.Build.props — FileScan
    Microserviço validador de arquivos (antimalware via ClamAV + validação estrutural).
    Convenções alinhadas ao portfólio ProjectStandard (.NET 10, nullable, CPM).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FileScan</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!--
    Gate fail-closed da cadeia de dependências: indisponibilidade dos dados (NU1900), advisory
    High (NU1903) ou Critical (NU1904), direto OU transitivo (NuGetAuditMode=all), vira ERRO de
    restore/build antes de qualquer pack/push. Moderate/Low continuam warnings.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
